modules = ["nodejs-20", "web", "bash"]

[deployment]
router = "application"
deploymentTarget = "vm"
run = ["node", "--enable-source-maps", "artifacts/api-server/dist/index.mjs"]
build = ["pnpm", "--filter", "@workspace/api-server", "run", "build"]

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]

[agent]
stack = "BEST_EFFORT_FALLBACK"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
PORT = "8080"
BOT_ENABLED = "1"

[userenv.production]

[[ports]]
localPort = 5000
externalPort = 80
